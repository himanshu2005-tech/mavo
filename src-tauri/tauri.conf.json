{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mavo",
  "version": "0.1.0",
  "identifier": "dev.mavo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mavo",
        "theme": "Dark",
        "width": 1280,
        "height": 800,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "A local-first personal AI assistant",
    "longDescription": "Mavo is a private, extensible personal AI platform powered by local models.",
    "resources": {
      "binaries/mavo-backend": "mavo-backend"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

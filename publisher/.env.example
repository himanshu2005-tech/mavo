# Server-only configuration. Copy to publisher/.env; never distribute this file.
MAVO_PUBLISHER_FIREBASE_PROJECT_ID=your-firebase-project-id
MAVO_PUBLISHER_API_KEY=
MAVO_PUBLISHER_MODEL=minimax/minimax-m3.1-flash
MAVO_PUBLISHER_REASONING_EFFORT=low
MAVO_PUBLISHER_USER_DAILY_LIMIT=50
MAVO_PUBLISHER_GLOBAL_DAILY_LIMIT=500
MAVO_PUBLISHER_MAX_OUTPUT_TOKENS=4096
MAVO_PUBLISHER_MAX_CONCURRENCY=4
# Server-only Google Desktop OAuth credentials for packaged sign-in/connections.
# For local development, existing root GOOGLE_CLIENT_ID/SECRET aliases are read.
MAVO_PUBLISHER_GOOGLE_CLIENT_ID=
MAVO_PUBLISHER_GOOGLE_CLIENT_SECRET=
MAVO_PUBLISHER_OAUTH_PER_IP_MINUTE=30
MAVO_PUBLISHER_OAUTH_PER_IP_DAY=2000
MAVO_PUBLISHER_OAUTH_GLOBAL_DAY=20000
# Docker uses /data; local Windows testing can use D:/DevTools/Mavo/publisher.
MAVO_PUBLISHER_DATA_DIR=/data
# Required only for the HTTPS Docker deployment. Use your actual domain.
MAVO_CORE_HOST=core.example.com

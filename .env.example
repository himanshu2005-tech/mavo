# Local development only. Copy this file to .env; never commit .env.
# Firebase public Web configuration belongs in backend/firebase.json.
# See DEVELOPMENT.md, docs/firebase-setup.md and publisher/README.md.
MAVO_CORE_GATEWAY_URL=http://127.0.0.1:8741
MAVO_REQUIRE_LOGIN=true

# Publisher-owned Desktop OAuth client for Google connectors.
# Keep the secret local/server-side; public users do not enter these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional separate Desktop OAuth client for Firebase identity.
# Leave blank when using the connector client with the documented Firebase allowlist.
MAVO_FIREBASE_GOOGLE_CLIENT_ID=
MAVO_FIREBASE_GOOGLE_CLIENT_SECRET=

# Public publisher GitHub App identity. Never put user access tokens here.
# See docs/github-app-setup.md.
MAVO_GITHUB_CLIENT_ID=
MAVO_GITHUB_APP_SLUG=
